# Build output is committed and served by GitHub Pages from docs/.
# Vite writes LF, but core.autocrlf=true checks these files back out as CRLF,
# so every build left the tree looking dirty with a phantom modification that
# `git diff` could not show. Marking them binary stops the conversion.
docs/** -text

# Keep source line endings stable across platforms too.
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
